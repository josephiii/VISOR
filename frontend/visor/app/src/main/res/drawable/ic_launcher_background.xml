<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer of VISOR's adaptive launcher icon.

  A deep navy wash drawn from the Clarity palette's blues (see
  ui/theme/Color.kt). It is kept dark on purpose: the foreground glyph is
  white, so every stop here clears 10:1 against it, well past the 4.5:1
  WCAG target even at the lightest point of the gradient.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF123F73"
                    android:offset="0.0" />
                <item
                    android:color="#FF0A2E57"
                    android:offset="0.55" />
                <item
                    android:color="#FF071F3C"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
