<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The activity theme. Compose supplies everything the user actually sees
      (see ui/theme/Theme.kt), so this only has to cover the two moments Compose
      cannot: the splash screen, and the window behind the first frame.

      minSdk is 31, so the platform splash screen attributes below always apply
      and no compatibility library is needed. The icon is the launcher icon's
      foreground layer, which means the mark the user tapped is the same mark
      that greets them.
    -->
    <style name="Theme.VISOR" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/visor_window_background</item>

        <item name="android:windowSplashScreenBackground">@color/visor_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/visor_splash_icon_background</item>
    </style>
</resources>
