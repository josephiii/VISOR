<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required permissions for MWDAT -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- For MWDAT mock device testing -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- For STT sherpa-onnx -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Lets SpeechRecognizer.isRecognitionAvailable() resolve the on-device recognizer
         service on Android 11+ (package-visibility rules) for voice navigation. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VISOR"
        android:usesCleartextTraffic="true"><!--REMOVE LINE LATER ONLY FOR HTTP REQUST -->

        <!-- Meta Wearables Device Access Toolkit Setup -->
        <!-- Supply them via local.properties (mwdat_application_id / mwdat_client_token) -
             see the manifestPlaceholders block in app/build.gradle.kts. Unset, they fall
             back to "0", which MWDAT 1.0 documents as the Developer Mode placeholder
             (attestation is skipped in Developer Mode). An *empty* value is not that
             placeholder: it made the glasses end every session immediately. Release
             channels and voice launches need the real Developer Center values. -->
        <meta-data
            android:name="com.meta.wearable.mwdat.APPLICATION_ID"
            android:value="${mwdat_application_id}" />
        <meta-data
            android:name="com.meta.wearable.mwdat.CLIENT_TOKEN"
            android:value="${mwdat_client_token}" />

        <!-- Opt out of Data Collection while using MWDAT -->
        <!-- (true = Opt out, i.e., analytics are disabled) -->
        <meta-data
            android:name="com.meta.wearable.mwdat.ANALYTICS_OPT_OUT"
            android:value="true" />

        <!-- SDK crash capture defaults to ON; VISOR opts out for the same reason it
             opts out of analytics. (DAM_ENABLED was removed: since MWDAT 0.9 the App
             Model is always on and the key is ignored.) -->
        <meta-data
            android:name="com.meta.wearable.mwdat.CRASH_REPORTING_OPT_OUT"
            android:value="true" />

        <!-- singleTask: a "Hey Meta, start VISOR" voice launch and the Meta AI
             registration callback must land in the running task (onNewIntent), not
             stack a second copy of VISOR over a live glasses session. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.VISOR"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter> <!-- Callback scheme Meta AI uses to return to the app  -->
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="visor" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>